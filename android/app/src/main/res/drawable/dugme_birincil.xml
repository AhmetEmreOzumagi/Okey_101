<?xml version="1.0" encoding="utf-8"?>
<!-- Büyük ana düğme: pirinç rengi, yuvarlak köşeli -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#F0C25E" android:endColor="@color/pirinc" />
            <stroke android:width="1dp" android:color="#60FFFFFF" />
        </shape>
    </item>
</ripple>
