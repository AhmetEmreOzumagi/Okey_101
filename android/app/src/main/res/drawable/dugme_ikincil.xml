<?xml version="1.0" encoding="utf-8"?>
<!-- Büyük ikinci düğme: fildişi, yuvarlak köşeli -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#30000000">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="270" android:startColor="#FFFDF6" android:endColor="@color/fildisi_golge" />
            <stroke android:width="1dp" android:color="#60FFFFFF" />
        </shape>
    </item>
</ripple>
