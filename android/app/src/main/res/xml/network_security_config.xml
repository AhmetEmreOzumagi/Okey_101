<?xml version="1.0" encoding="utf-8"?>
<!-- Oyun yerel ağda http:// ile konuşur (192.168.x.x gibi adreslere sertifika alınamaz).
     Bu yüzden şifresiz (cleartext) HTTP'ye izin verilir; uygulama internete hiç çıkmaz. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
